---
import BlogLayout from "../layouts/BlogLayout.astro";
import L from "../components/L.astro";
import {
  ERAS,
  MILESTONES,
  JOBS,
  GITHUB_YEAR_STATS,
  GITHUB_TOTAL_COMMITS,
  eraForYear,
  type Era,
  type Milestone,
  type Job,
} from "../data/timeline.ts";

// La línea de tiempo se presenta como un `git log --graph`: tres ramas paralelas
// (GitHub, GitLab y Trabajo) y cada hito es un "commit" sobre su rama. Se agrupa
// por eras (capítulos) y, dentro de cada era, por año.

type Lane = "github" | "gitlab" | "work";
type Entry = {
  id: string;
  date: string;
  year: number;
  lane: Lane;
  isHito: boolean;
  isJob: boolean;
  m?: Milestone;
  j?: Job;
  search: string;
};

const yearOf = (iso: string) => Number(iso.slice(0, 4));

// Slug estable para enlazar un hito (#h-2019-05-19-las-notas-del-sena)
const slug = (s: string) =>
  s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 48);

const usedIds = new Set<string>();
const uniqueId = (base: string) => {
  let id = base, n = 2;
  while (usedIds.has(id)) id = `${base}-${n++}`;
  usedIds.add(id);
  return id;
};

const entries: Entry[] = [
  ...MILESTONES.map((m): Entry => ({
    id: uniqueId(`h-${m.date}-${slug(m.title)}`),
    date: m.date, year: yearOf(m.date), lane: m.source, isHito: m.kind === "milestone", isJob: false, m,
    search: [m.title, m.titleEn, m.desc, m.descEn, ...m.repos].filter(Boolean).join(" ").toLowerCase(),
  })),
  ...JOBS.map((j): Entry => ({
    id: uniqueId(`h-${j.date}-${slug(j.role + " " + j.org)}`),
    date: j.date, year: yearOf(j.date), lane: "work", isHito: false, isJob: true, j,
    search: [j.role, j.roleEn, j.org, j.desc, j.descEn, ...j.tech].filter(Boolean).join(" ").toLowerCase(),
  })),
].sort((a, b) => a.date.localeCompare(b.date));

// Cada era enlaza al capítulo de la serie «historia en git» del blog
const ERA_POSTS: Record<string, string> = {
  origenes: "historia-el-dia-cero",
  pandemia: "historia-modelando-la-pandemia",
  universidad: "historia-dando-clase-en-el-glud",
  sabatico: "historia-el-ano-que-casi-no-existio",
  "gran-anio": "historia-el-gran-ano-y-la-tesis",
  banco: "historia-el-salto-al-banco",
  maestria: "historia-la-maestria-y-el-presente",
};

const chapters = ERAS.map((era: Era, i) => {
  const items = entries.filter((e) => e.year >= era.from && e.year <= era.to);
  const years = [...new Set(items.map((e) => e.year))].sort();
  const commits = GITHUB_YEAR_STATS.filter((s) => s.year >= era.from && s.year <= era.to)
    .reduce((sum, s) => sum + s.commits, 0);
  return {
    era, n: i + 1, commits, years,
    byYear: years.map((y) => ({ year: y, items: items.filter((e) => e.year === y) })),
    hitos: items.filter((e) => !e.isJob).length,
    jobs: items.filter((e) => e.isJob).length,
    post: ERA_POSTS[era.id],
  };
}).filter((c) => c.years.length > 0);

const chart = GITHUB_YEAR_STATS.slice().sort((a, b) => a.year - b.year);
const maxCommits = Math.max(...chart.map((s) => s.commits));
const peakYear = chart.find((s) => s.commits === maxCommits)?.year;
const allYears = new Set(entries.map((e) => e.year));

const fmt = (iso: string, loc: string, withDay = true) =>
  new Date(iso + "T00:00:00Z").toLocaleDateString(loc, {
    year: "numeric", month: "short", ...(withDay ? { day: "numeric" } : {}), timeZone: "UTC",
  });
const range = (j: Job, loc: string, now: string) =>
  `${fmt(j.date, loc, false)} — ${j.current || !j.end ? now : fmt(j.end, loc, false)}`;
const yearsLabel = (e: Era) => (e.from === e.to ? `${e.from}` : `${e.from}–${e.to}`);
const pad = (n: number) => String(n).padStart(2, "0");
---

<BlogLayout
  title="timeline"
  description="Línea de tiempo interactiva de Juan Felipe Rodríguez Galindo (Juferoga): del primer repo en 2018 a la maestría en IA en 2026, con hitos de GitHub y GitLab."
  path="/timeline/"
  section="timeline"
>
  <header class="page-head">
    <span class="page-kicker">~/timeline · <span class="tl-cmd">git log --graph --all --since=2018</span></span>
    <h1 class="page-title"><L es="Línea de tiempo" en="Timeline" /></h1>
    <p class="page-lead">
      <L
        es={`De ${chart[0].year} a ${chart[chart.length - 1].year}: mi historia contada como un repositorio. Cada hito es un commit sobre su rama; toca cualquiera para ver el detalle.`}
        en={`From ${chart[0].year} to ${chart[chart.length - 1].year}: my story told as a repository. Every milestone is a commit on its branch — tap any of them for the details.`}
      />
    </p>
    <div class="tl-stats">
      <div><strong>{chapters.length}</strong><span><L es="capítulos" en="chapters" /></span></div>
      <div><strong>{MILESTONES.length}</strong><span><L es="hitos en GitHub y GitLab" en="GitHub & GitLab milestones" /></span></div>
      <div><strong>{JOBS.length}</strong><span><L es="empleos y roles" en="jobs & roles" /></span></div>
      <div><strong><L es={GITHUB_TOTAL_COMMITS.toLocaleString("es-CO")} en={GITHUB_TOTAL_COMMITS.toLocaleString("en-US")} /></strong><span><L es="contribuciones" en="contributions" /></span></div>
    </div>
    <ul class="tl-legend" aria-label="Leyenda / Legend">
      <li><span class="lg-dot lg-github"></span>GitHub</li>
      <li><span class="lg-dot lg-gitlab"></span>GitLab</li>
      <li><span class="lg-dot lg-work"></span><L es="Trabajo" en="Work" /></li>
      <li><span class="lg-dot lg-hito"></span><L es="Hito clave" en="Key milestone" /></li>
    </ul>
  </header>

  <!-- ===================== GRÁFICO DE COMMITS (por era, clicable) ===================== -->
  <section class="tl-chart" aria-labelledby="tl-chart-h" data-reveal>
    <h2 id="tl-chart-h" class="tl-h"><span class="tl-h-prompt">$</span> git shortlog --per-year</h2>
    <ul class="tl-bars" role="list">
      {chart.map((s) => {
        const pct = Math.max(3, Math.round((s.commits / maxCommits) * 100));
        const era = eraForYear(s.year);
        const inner = (
          <>
            <span class="tl-bar-year">{s.year}</span>
            <span class="tl-bar-track"><span class="tl-bar-fill" style={`width:${pct}%`}></span></span>
            <span class="tl-bar-num">
              {s.commits}{s.year === peakYear && <span class="tl-bar-flag"> ◄ <L es="pico" en="peak" /></span>}
            </span>
          </>
        );
        return (
          <li class={`tl-bar-row${s.year === peakYear ? " is-peak" : ""}`} style={`--era:${era?.color ?? "var(--accent)"}`}>
            {allYears.has(s.year)
              ? <a class="tl-bar-link" href={`#y-${s.year}`}>{inner}</a>
              : <span class="tl-bar-link">{inner}</span>}
          </li>
        );
      })}
    </ul>
    <p class="tl-chart-note">
      <L es="contribuciones GitHub por año · color de cada era · toca un año para ir allí" en="GitHub contributions per year · colored by era · tap a year to jump there" />
    </p>
  </section>

  <!-- ===================== RIEL DE ERAS (fijo bajo la navbar) ===================== -->
  <nav class="tl-rail" aria-label="Capítulos / Chapters" data-tl-rail>
    <div class="tl-rail-track">
      {chapters.map((c) => (
        <a class="tl-rail-seg" href={`#era-${c.era.id}`} data-rail={c.era.id}
          style={`--era:${c.era.color}; flex-grow:${c.hitos + c.jobs}`} title={c.era.title}>
          <span class="tl-rail-fill" aria-hidden="true"></span>
          <span class="tl-rail-emoji" aria-hidden="true">{c.era.emoji}</span>
          <span class="tl-rail-label">{yearsLabel(c.era)}</span>
        </a>
      ))}
    </div>
    <span class="tl-rail-year" aria-live="off" data-tl-now>{chapters[0].years[0]}</span>
  </nav>

  <!-- ===================== CONTROLES ===================== -->
  <div class="tl-controls">
    <label class="tl-grep">
      <span class="tl-grep-prompt" aria-hidden="true">git log --grep=</span>
      <input type="search" data-tl-grep autocomplete="off" spellcheck="false"
        placeholder="angular, glud, tesis…" aria-label="Buscar en la línea de tiempo / Search the timeline" />
    </label>
    <div class="tl-filters" role="group" aria-label="Filtrar / Filter">
      <button type="button" class="tl-filter is-active" data-filter="all" aria-pressed="true"><L es="Todo" en="All" /></button>
      <button type="button" class="tl-filter" data-filter="github" aria-pressed="false">GitHub</button>
      <button type="button" class="tl-filter" data-filter="gitlab" aria-pressed="false">GitLab</button>
      <button type="button" class="tl-filter" data-filter="hitos" aria-pressed="false">★ <L es="Hitos" en="Milestones" /></button>
      <button type="button" class="tl-filter" data-filter="trabajo" aria-pressed="false">💼 <L es="Trabajo" en="Work" /></button>
    </div>
    <div class="tl-tools">
      <span class="tl-count" aria-live="polite" data-tl-count></span>
      <button type="button" class="tl-expand" data-tl-expand aria-pressed="false">
        <span data-l="es">⇕ Expandir todo</span><span data-l="en">⇕ Expand all</span>
      </button>
    </div>
  </div>

  <!-- ===================== CAPÍTULOS ===================== -->
  <div class="tl-root" data-tl-root>
    {chapters.map((c) => (
      <section class="tl-chapter" id={`era-${c.era.id}`} data-chapter={c.era.id} style={`--era:${c.era.color}`}>
        <header class="tl-chapter-head" data-reveal>
          <span class="tl-chapter-emoji" aria-hidden="true">{c.era.emoji}</span>
          <div class="tl-chapter-text">
            <span class="tl-chapter-kicker">
              <L es={`Capítulo ${pad(c.n)}`} en={`Chapter ${pad(c.n)}`} /> · {yearsLabel(c.era)}
            </span>
            <h2 class="tl-chapter-title"><L es={c.era.title} en={c.era.titleEn} /></h2>
            <p class="tl-chapter-summary"><L es={c.era.summary} en={c.era.summaryEn} /></p>
            <div class="tl-chapter-meta">
              <span><strong>{c.commits}</strong> commits</span>
              <span><strong>{c.hitos}</strong> <L es="hitos" en="milestones" /></span>
              {c.jobs > 0 && <span><strong>{c.jobs}</strong> <L es={c.jobs === 1 ? "rol" : "roles"} en={c.jobs === 1 ? "role" : "roles"} /></span>}
              {c.post && (
                <a class="tl-chapter-post" href={`/blog/${c.post}/`}>
                  <L es="Leer la historia completa" en="Read the full story" /> <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>
        </header>

        {c.byYear.map((y) => (
          <div class="tl-year" id={`y-${y.year}`} data-tl-year={y.year}>
            <div class="tl-tag" aria-hidden="true"><span>tag: v{y.year}</span></div>
            <h3 class="sr-only">{y.year}</h3>
            <ul class="tl-list" role="list">
              {y.items.map((e) => {
                const m = e.m, j = e.j;
                return (
                  <li class={`tl-item lane-${e.lane}`} id={e.id} data-tl-item data-reveal
                    data-source={j ? "work" : m!.source} data-kind={j ? "job" : m!.kind} data-search={e.search}>
                    <span class="tl-graph" aria-hidden="true"><span class="tl-dot"></span></span>
                    <div class="tl-card">
                      <button type="button" class={`tl-node${e.isHito ? " is-hito" : ""}${e.isJob ? " is-job" : ""}`}
                        id={`${e.id}-btn`} aria-expanded="false" aria-controls={`${e.id}-panel`} data-tl-node>
                        <span class="tl-node-main">
                          <span class="tl-node-top">
                            {j ? (
                              <time class="tl-node-date" datetime={j.date}>
                                <L es={range(j, "es-CO", "actualidad")} en={range(j, "en-US", "present")} />
                              </time>
                            ) : (
                              <time class="tl-node-date" datetime={m!.date}>
                                <L es={fmt(m!.date, "es-CO")} en={fmt(m!.date, "en-US")} />
                              </time>
                            )}
                            {j && <span class="tl-flag tl-flag--work">💼 <L es="trabajo" en="work" /></span>}
                            {j?.private && <span class="tl-flag tl-flag--priv">🔒 <L es="GitLab privado" en="private GitLab" /></span>}
                            {j?.current && <span class="tl-flag tl-flag--now">● <L es="actual" en="current" /></span>}
                            {m && <span class={`tl-src tl-src--${m.source}`}>{m.source === "github" ? "GH" : "GL"}</span>}
                            {e.isHito && <span class="tl-flag tl-flag--hito">★ <L es="hito" en="milestone" /></span>}
                          </span>
                          <span class="tl-node-title">
                            {j ? (
                              <><L es={j.role} en={j.roleEn} /> <span class="tl-node-org">· {j.org}</span></>
                            ) : (
                              <L es={m!.title} en={m!.titleEn} />
                            )}
                          </span>
                        </span>
                        <span class="tl-caret" aria-hidden="true">▸</span>
                      </button>
                      <div class="tl-panel" id={`${e.id}-panel`} role="region" aria-labelledby={`${e.id}-btn`} hidden>
                        <p class="tl-desc"><L es={(j ?? m)!.desc} en={(j ?? m)!.descEn} /></p>
                        {j?.note && <p class="tl-note"><L es={j.note} en={j.noteEn} /></p>}
                        {j && j.tech.length > 0 && (
                          <p class="tl-chips"><span class="tl-chips-label">stack:</span>{j.tech.map((t) => <span class="tl-chip">{t}</span>)}</p>
                        )}
                        {m && m.repos.length > 0 && (
                          <p class="tl-chips"><span class="tl-chips-label">repos:</span>{m.repos.map((r) => <span class="tl-chip tl-chip--repo">{r}</span>)}</p>
                        )}
                        {j?.private && !j.url && (
                          <p class="tl-muted"><L es="// código en GitLab privado/institucional — sin repo público" en="// code lives in private/institutional GitLab — no public repo" /></p>
                        )}
                        <p class="tl-actions">
                          {(j?.url || m?.url) && (
                            <a class="tl-open" href={(j?.url ?? m?.url)!} target="_blank" rel="noopener noreferrer">
                              {j ? <L es="abrir repo relacionado ↗" en="open related repo ↗" />
                                 : <L es={`abrir en ${m!.source === "github" ? "GitHub" : "GitLab"} ↗`} en={`open on ${m!.source === "github" ? "GitHub" : "GitLab"} ↗`} />}
                            <span class="sr-only"> <L es="(abre en una nueva ventana)" en="(opens in a new window)" /></span></a>
                          )}
                          <button type="button" class="tl-copy" data-tl-copy={e.id}>
                            <span data-l="es">🔗 copiar enlace</span><span data-l="en">🔗 copy link</span>
                          </button>
                        </p>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </section>
    ))}

    <div class="tl-head" data-reveal>
      <span class="tl-graph" aria-hidden="true"><span class="tl-dot tl-dot--head"></span></span>
      <div>
        <p class="tl-head-ref"><span class="tl-head-label">HEAD</span> → main</p>
        <p class="tl-head-text">
          <L es="La historia sigue: el próximo commit está en camino." en="The story goes on: the next commit is on its way." />
        </p>
        <p class="tl-head-links">
          <a href="/blog/"><L es="Leer la serie en el blog" en="Read the series on the blog" /> →</a>
          <a href="/?view=visual"><L es="Ver el portafolio" en="See the portfolio" /> →</a>
        </p>
      </div>
    </div>

    <p class="tl-empty" data-tl-empty hidden>
      <L es="// sin commits que coincidan — prueba otra búsqueda" en="// no matching commits — try another search" />
    </p>
  </div>
</BlogLayout>

<script>
  import { tr } from "../i18n/lang";

  const root = document.querySelector<HTMLElement>("[data-tl-root]");
  if (root) {
    const nodes = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tl-node]"));
    const items = Array.from(root.querySelectorAll<HTMLLIElement>("[data-tl-item]"));
    const yearsEls = Array.from(root.querySelectorAll<HTMLElement>("[data-tl-year]"));
    const chaptersEls = Array.from(root.querySelectorAll<HTMLElement>("[data-chapter]"));
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>(".tl-filter"));
    const grep = document.querySelector<HTMLInputElement>("[data-tl-grep]")!;
    const countEl = document.querySelector<HTMLElement>("[data-tl-count]")!;
    const emptyEl = document.querySelector<HTMLElement>("[data-tl-empty]")!;
    const expandBtn = document.querySelector<HTMLButtonElement>("[data-tl-expand]")!;

    // ── Expandir / colapsar ──
    function toggle(btn: HTMLButtonElement, force?: boolean) {
      const panel = document.getElementById(btn.getAttribute("aria-controls") || "");
      if (!panel) return;
      const open = force ?? btn.getAttribute("aria-expanded") !== "true";
      btn.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
    }
    nodes.forEach((btn) => btn.addEventListener("click", () => {
      toggle(btn);
      // el hito abierto queda en la URL: se puede compartir
      const item = btn.closest<HTMLElement>("[data-tl-item]")!;
      if (btn.getAttribute("aria-expanded") === "true") history.replaceState(null, "", `#${item.id}`);
    }));

    expandBtn.addEventListener("click", () => {
      const open = expandBtn.getAttribute("aria-pressed") !== "true";
      expandBtn.setAttribute("aria-pressed", String(open));
      nodes.forEach((b) => { if (!b.closest<HTMLElement>("[data-tl-item]")!.hidden) toggle(b, open); });
      expandBtn.querySelector('[data-l="es"]')!.textContent = open ? "⇕ Contraer todo" : "⇕ Expandir todo";
      expandBtn.querySelector('[data-l="en"]')!.textContent = open ? "⇕ Collapse all" : "⇕ Expand all";
    });

    // ── Copiar enlace a un hito ──
    root.addEventListener("click", async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-tl-copy]");
      if (!b) return;
      const url = `${location.origin}${location.pathname}#${b.dataset.tlCopy}`;
      try { await navigator.clipboard.writeText(url); } catch { history.replaceState(null, "", `#${b.dataset.tlCopy}`); }
      b.classList.add("is-done");
      setTimeout(() => b.classList.remove("is-done"), 1600);
    });

    // ── Filtros + búsqueda (git log --grep) ──
    let filter = "all";
    const matchesFilter = (it: HTMLElement) =>
      filter === "all" ? true
      : filter === "hitos" ? it.dataset.kind === "milestone"
      : filter === "trabajo" ? it.dataset.kind === "job"
      : it.dataset.source === filter;

    function apply() {
      const q = grep.value.trim().toLowerCase();
      let visible = 0;
      items.forEach((it) => {
        const show = matchesFilter(it) && (!q || (it.dataset.search ?? "").includes(q));
        it.hidden = !show;
        if (show) visible++;
        else {
          const btn = it.querySelector<HTMLButtonElement>("[data-tl-node]");
          if (btn?.getAttribute("aria-expanded") === "true") toggle(btn, false);
        }
      });
      const anyIn = (el: HTMLElement) => Array.from(el.querySelectorAll<HTMLElement>("[data-tl-item]")).some((i) => !i.hidden);
      yearsEls.forEach((y) => (y.hidden = !anyIn(y)));
      chaptersEls.forEach((c) => (c.hidden = !anyIn(c)));
      emptyEl.hidden = visible > 0;
      const label =
        filter === "hitos" ? tr("hitos clave", "key milestones")
        : filter === "trabajo" ? tr("empleos y roles", "jobs & roles")
        : filter === "all" ? "commits"
        : filter;
      countEl.textContent = `${visible} ${label}`;
      onScroll();
    }

    filters.forEach((f) => f.addEventListener("click", () => {
      filters.forEach((o) => { o.classList.toggle("is-active", o === f); o.setAttribute("aria-pressed", String(o === f)); });
      filter = f.dataset.filter || "all";
      apply();
    }));
    let grepTimer = 0;
    grep.addEventListener("input", () => { clearTimeout(grepTimer); grepTimer = window.setTimeout(apply, 120); });
    window.addEventListener("langchange", apply);

    // ── Navegación por teclado (↑/↓ entre hitos visibles) ──
    root.addEventListener("keydown", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-tl-node]");
      if (!btn) return;
      const vis = nodes.filter((n) => !n.closest<HTMLElement>("[data-tl-item]")!.hidden);
      const i = vis.indexOf(btn);
      const go = (b?: HTMLButtonElement) => { e.preventDefault(); b?.focus(); };
      if (e.key === "ArrowDown") go(vis[i + 1] ?? vis[0]);
      else if (e.key === "ArrowUp") go(vis[i - 1] ?? vis[vis.length - 1]);
      else if (e.key === "Home") go(vis[0]);
      else if (e.key === "End") go(vis[vis.length - 1]);
    });

    // ── Riel de eras: capítulo activo, progreso dentro de él y año actual ──
    const segs = new Map(Array.from(document.querySelectorAll<HTMLElement>("[data-rail]")).map((s) => [s.dataset.rail!, s]));
    const nowEl = document.querySelector<HTMLElement>("[data-tl-now]")!;
    const rail = document.querySelector<HTMLElement>("[data-tl-rail]")!;
    let ticking = false;
    function onScroll() {
      ticking = false;
      const probe = window.innerHeight * 0.35;
      let activeId = "";
      chaptersEls.forEach((c) => {
        const seg = segs.get(c.dataset.chapter!);
        if (!seg) return;
        const r = c.getBoundingClientRect();
        const p = c.hidden ? 0 : Math.min(1, Math.max(0, (probe - r.top) / Math.max(1, r.height)));
        seg.style.setProperty("--p", String(p));
        if (!c.hidden && r.top <= probe && r.bottom > probe) activeId = c.dataset.chapter!;
      });
      segs.forEach((s, id) => s.classList.toggle("is-active", id === activeId));
      let year = "";
      for (const y of yearsEls) {
        if (y.hidden) continue;
        // el primer año de cada capítulo empieza en la portada del capítulo, no en su etiqueta
        const chapter = y.closest<HTMLElement>("[data-chapter]")!;
        const first = chapter.querySelector<HTMLElement>("[data-tl-year]:not([hidden])") === y;
        if ((first ? chapter : y).getBoundingClientRect().top <= probe) year = y.dataset.tlYear!;
      }
      if (year && nowEl.textContent !== year) {
        nowEl.textContent = year;
        nowEl.classList.remove("tick"); void nowEl.offsetWidth; nowEl.classList.add("tick");
      }
      rail.classList.toggle("is-stuck", rail.getBoundingClientRect().top <= parseFloat(getComputedStyle(rail).top) + 1);
    }
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });

    // ── Enlace directo a un hito (#h-…): abrirlo y llevarlo a la vista ──
    function openFromHash() {
      const id = decodeURIComponent(location.hash.slice(1));
      const item = id.startsWith("h-") ? document.getElementById(id) : null;
      if (!item) return;
      const btn = item.querySelector<HTMLButtonElement>("[data-tl-node]");
      if (btn) toggle(btn, true);
      item.classList.add("in", "is-target");
      requestAnimationFrame(() => item.scrollIntoView({ block: "center" }));
    }
    window.addEventListener("hashchange", openFromHash);

    apply();
    openFromHash();
  }
</script>

<style>
