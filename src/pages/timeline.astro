  .tl-head-text { margin-top: 8px; font-family: var(--sans); color: var(--text); }
  .tl-head-links { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 12px; font-size: 13px; }
  .tl-head-links a { color: var(--link); text-decoration: none; }
