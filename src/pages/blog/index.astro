---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import L from "../../components/L.astro";
import { readingMinutes } from "../../utils/reading";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// la fecha se renderiza en ambos formatos y el CSS muestra la del idioma activo
const fmt = (d: Date, locale: "es-CO" | "en-US" = "es-CO") =>
  d.toLocaleDateString(locale, { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

<BlogLayout
  title="blog"
  description="Blog de Juan Felipe Rodríguez Galindo — notas sobre cloud, backend, IA aplicada y software libre."
  path="/blog/"
  section="blog"
>
  <header class="page-head">
    <span class="page-kicker">~/blog</span>
    <h1 class="page-title">Blog</h1>
    <p class="page-lead" data-l="es">
      Notas sobre cloud, backend, IA aplicada y software libre — cortas y al grano, como un buen commit.
    </p>
    <p class="page-lead" data-l="en">
      Notes on cloud, backend, applied AI and free software — short and to the point, like a good commit.
    </p>
    <p class="page-note" data-l="en">🇪🇸 The articles are written in Spanish.</p>
  </header>

  <a class="tl-cta panel" href="/timeline/" data-reveal>
    <span class="tl-cta-icon" aria-hidden="true">🕰️</span>
    <span class="tl-cta-text">
      <strong><L es="Serie «historia en git»" en="The “history in git” series" /></strong>
      <span data-l="es">Ocho años de commits contados como una historia — y su línea de tiempo interactiva.</span>
      <span data-l="en">Eight years of commits told as a story — plus its interactive timeline.</span>
    </span>
    <span class="tl-cta-arrow" aria-hidden="true">→</span>
  </a>

  <ul class="post-grid">
    {posts.map((post) => (
      <li data-reveal>
        <a class="post-card panel" href={`/blog/${post.id}/`}>
          <span class="post-meta">
            <time datetime={post.data.date.toISOString()}><L es={fmt(post.data.date)} en={fmt(post.data.date, "en-US")} /></time>
            <span aria-hidden="true">·</span>
            <span>{readingMinutes(post.body)} <L es="min de lectura" en="min read" /></span>
          </span>
          <h2 class="post-title"><L es={post.data.title} en={post.data.titleEn ?? post.data.title} /></h2>
          <p class="post-desc"><L es={post.data.description} en={post.data.descriptionEn ?? post.data.description} /></p>
          {post.data.tags.length > 0 && (
            <span class="post-tags">{post.data.tags.slice(0, 4).map((t) => <span class="pill">#{t}</span>)}</span>
          )}
          <span class="post-read"><L es="Leer artículo" en="Read article" /> <span class="post-read-arrow" aria-hidden="true">→</span></span>
        </a>
      </li>
    ))}
  </ul>
</BlogLayout>

<style>
  .tl-cta {
    display: flex; align-items: center; gap: 16px; padding: 18px 22px; margin-bottom: 28px;
    text-decoration: none; color: var(--text);
    background: radial-gradient(500px circle at 0% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%), var(--surface);
    transition: border-color 0.25s, transform 0.25s;
  }
  .tl-cta:hover { border-color: color-mix(in srgb, var(--accent) 55%, transparent); transform: translateY(-2px); }
  .tl-cta-icon { font-size: 26px; }
  .tl-cta-text { flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .tl-cta-text strong { color: var(--fg-bright); }
  .tl-cta-text > span { font-family: var(--sans); font-size: 14.5px; color: var(--text-dim); }
  .tl-cta-arrow { color: var(--accent); font-size: 20px; transition: transform 0.25s; }
  .tl-cta:hover .tl-cta-arrow { transform: translateX(4px); }

  .page-note { margin-top: 10px; font-size: 13px; color: var(--text-dim); }

  .post-grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px; }
  .post-card {
    height: 100%; display: flex; flex-direction: column; gap: 10px; padding: 22px;
    text-decoration: none; color: var(--text);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.3s, box-shadow 0.3s;
  }
  .post-card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 55%, transparent); box-shadow: 0 18px 40px -22px var(--glow); }
  .post-meta { display: flex; gap: 8px; flex-wrap: wrap; font-size: 12.5px; color: var(--text-dim); }
  .post-title { font-size: 17px; line-height: 1.4; color: var(--fg-bright); }
  .post-desc { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: var(--text); }
  .post-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 4px; }
  .post-read { font-size: 13px; color: var(--link); }
  .post-read-arrow { display: inline-block; transition: transform 0.25s; }
  .post-card:hover .post-read-arrow { transform: translateX(4px); }

  @media (max-width: 640px) {
    .post-grid { grid-template-columns: 1fr; }
    .tl-cta { padding: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-card:hover, .tl-cta:hover { transform: none; }
  }
</style>
