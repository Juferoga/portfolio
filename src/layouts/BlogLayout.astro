---
import "../styles/global.css";
import "../styles/pages.css";
import L from "../components/L.astro";
import { PROFILE } from "../data/profile";

interface Props {
  title: string;
  description: string;
  /** Ruta canónica, p.ej. "/blog" o "/blog/hola-mundo" */
  path: string;
  /** Fecha de publicación (solo posts) — activa metadatos de artículo */
  publishedDate?: Date;
  /** Sección activa en la navbar */
  section?: "blog" | "timeline";
  /** Ancho de lectura (artículos) en vez del ancho completo */
  narrow?: boolean;
}

const { title, description, path, publishedDate, section = "blog", narrow = false } = Astro.props;
const NAV = [
  { href: "/?view=visual", es: "Inicio", en: "Home", key: "home" },
  { href: "/blog/", es: "Blog", en: "Blog", key: "blog" },
  { href: "/timeline/", es: "Timeline", en: "Timeline", key: "timeline" },
] as const;
const canonical = `https://juferoga.pro${path}`;
const fullTitle = title === "blog" ? "blog · juferoga.pro" : `${title} · blog · juferoga.pro`;

const jsonLd = publishedDate
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: publishedDate.toISOString(),
      dateModified: publishedDate.toISOString(),
      inLanguage: "es",
      url: canonical,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      image: "https://juferoga.pro/og.png",
      publisher: { "@type": "Person", "@id": "https://juferoga.pro/#person", name: PROFILE.name },
      isPartOf: { "@type": "Blog", "@id": "https://juferoga.pro/blog/#blog" },
      author: { "@type": "Person", "@id": "https://juferoga.pro/#person", name: PROFILE.name, url: "https://juferoga.pro" },
    }
  : {
      "@context": "https://schema.org",
      "@type": "Blog",
      "@id": "https://juferoga.pro/blog/#blog",
      name: "juferoga.pro — blog",
      description,
      inLanguage: "es",
      url: canonical,
      author: { "@type": "Person", "@id": "https://juferoga.pro/#person", name: PROFILE.name, url: "https://juferoga.pro" },
    };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <!-- idioma elegido en el sitio (clave compartida "lang"), antes del primer paint: sin parpadeo -->
    <script is:inline>
      try { if (localStorage.getItem("lang") === "en") document.documentElement.lang = "en"; } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={PROFILE.name} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={publishedDate ? "article" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://juferoga.pro/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Tarjeta de presentación de ${PROFILE.name} con estética de terminal`} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="juferoga.pro" />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://juferoga.pro/og.png" />

    <meta name="theme-color" content="#0a0e0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="juferoga.pro — blog" href="/rss.xml" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="site-page">
    <!-- mismo tema de color que eligió el visitante en la terminal / versión visual -->
    <script is:inline>
      try { var th = localStorage.getItem("theme"); if (th === "theme-amber" || th === "theme-cyber") document.body.classList.add(th); } catch (e) {}
    </script>
    <div class="site-progress" aria-hidden="true"><span></span></div>

    <nav class="site-nav" aria-label="Navegación principal" data-i18n-aria-es="Navegación principal" data-i18n-aria-en="Main navigation">
      <a href="/?view=visual" class="site-brand"><span class="site-brand-prompt">~/</span>{PROFILE.handle}<span class="site-brand-caret" aria-hidden="true">_</span></a>
      <div class="site-links">
        {NAV.map((n) => (
          <a href={n.href} aria-current={n.key === section ? "page" : undefined}><L es={n.es} en={n.en} /></a>
        ))}
        <a href="/rss.xml">RSS</a>
      </div>
      <button type="button" class="site-lang" data-site-lang aria-label="Cambiar idioma / Switch language">🌐 <L es="EN" en="ES" /></button>
      <a href="/" class="site-term" title="Versión terminal" aria-label="Versión terminal" data-i18n-es="Versión terminal" data-i18n-en="Terminal version"><span class="site-term-icon" aria-hidden="true">&gt;_</span> <span class="site-term-text">Terminal</span></a>
    </nav>

    <main class={`site-main${narrow ? " is-narrow" : ""}`} id="top">
      <slot />
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {PROFILE.name} · <em>“{PROFILE.tagline}”</em></span>
      <span class="site-footer-links">
        <a href="/?view=visual"><L es="Portafolio" en="Portfolio" /></a>
        <a href={PROFILE.contact.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={PROFILE.contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="/rss.xml">RSS</a>
      </span>
    </footer>

    <a class="site-top" href="#top" title="Volver arriba" aria-label="Volver arriba" data-i18n-es="Volver arriba" data-i18n-en="Back to top">↑</a>

    <script>
      import { getLang, setLang } from "../i18n/lang";
      document.querySelector("[data-site-lang]")?.addEventListener("click", () => {
        setLang(getLang() === "en" ? "es" : "en");
      });

      // Atributos que no pueden ser <span> (title / aria-label): se traducen desde JS.
      //   data-i18n-es/en      → title + aria-label
      //   data-i18n-aria-es/en → solo aria-label
      function syncAttrs() {
        const lang = getLang();
        document.querySelectorAll<HTMLElement>("[data-i18n-es]").forEach((el) => {
          const txt = el.dataset[lang === "en" ? "i18nEn" : "i18nEs"];
          if (!txt) return;
          el.title = txt;
          el.setAttribute("aria-label", txt);
        });
        document.querySelectorAll<HTMLElement>("[data-i18n-aria-es]").forEach((el) => {
          const txt = el.dataset[lang === "en" ? "i18nAriaEn" : "i18nAriaEs"];
          if (txt) el.setAttribute("aria-label", txt);
        });
      }
      syncAttrs();
      window.addEventListener("langchange", syncAttrs);

      // Progreso de lectura, borde de la navbar, botón "arriba" y aparición al hacer scroll.
      const body = document.body;
      const bar = document.querySelector(".site-progress span") as HTMLElement;
      let ticking = false;
      function onScroll() {
        ticking = false;
        const y = window.scrollY;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.setProperty("--p", String(max > 0 ? Math.min(1, y / max) : 0));
        body.classList.toggle("scrolled", y > 8);
        body.classList.toggle("scrolled-far", y > window.innerHeight * 0.9);
      }
      window.addEventListener("scroll", () => {
        if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
      }, { passive: true });
      onScroll();

      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (els.length && "IntersectionObserver" in window) {
        els.forEach((el) => {
          const sibs = Array.from(el.parentElement?.children ?? []).filter((c) => c.hasAttribute("data-reveal"));
          el.style.setProperty("--i", String(Math.min(sibs.indexOf(el), 6)));
        });
        body.classList.add("reveal-ready");
        const io = new IntersectionObserver((entries) => {
          for (const en of entries) if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); }
        }, { rootMargin: "0px 0px -6% 0px", threshold: 0.05 });
        els.forEach((el) => io.observe(el));
      }
    </script>

    {import.meta.env.PROD && (
      <script is:inline data-goatcounter="https://juferoga.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    )}
  </body>
</html>
